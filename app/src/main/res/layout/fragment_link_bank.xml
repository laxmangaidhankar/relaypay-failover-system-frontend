<?xml version="1.0" encoding="utf-8"?>

<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_bottom_sheet"
    android:orientation="vertical">

    <View
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="10dp"
        android:background="@drawable/bg_drag_handle" />

    <LinearLayout
        android:id="@+id/stateForm"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="16dp"
        android:paddingEnd="20dp"
        android:paddingBottom="28dp"
        android:visibility="visible"
        tools:visibility="visible">

        <!-- Sheet title row -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="4dp">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <FrameLayout
                    android:layout_width="36dp"
                    android:layout_height="36dp">

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_gravity="center"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_bank"
                        app:tint="@color/brand_blue" />
                </FrameLayout>

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/link_bank_title"
                        android:textColor="@color/md3_on_surface"
                        android:textSize="18sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="1dp"
                        android:text="@string/link_bank_subtitle"
                        android:textColor="@color/md3_on_surface_variant"
                        android:textSize="12sp" />
                </LinearLayout>
            </LinearLayout>

            <!-- Close button -->
            <ImageView
                android:id="@+id/ivCloseSheet"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:background="@drawable/bg_step_icon_pending"
                android:clickable="true"
                android:contentDescription="Close"
                android:focusable="true"
                android:padding="8dp"
                android:src="@drawable/ic_group"
                app:tint="@color/md3_on_surface_variant" />
        </RelativeLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="16dp"
            android:background="@color/md3_outline_variant" />

        <!-- ── SECTION 1: Bank picker ── -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:letterSpacing="0.02"
            android:text="@string/select_bank_label"
            android:textColor="@color/md3_on_surface"
            android:textSize="13sp"
            android:textStyle="bold" />

        <!-- Selected bank chip (shown after selection, hidden until then) -->
        <LinearLayout
            android:id="@+id/selectedBankRow"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_selected_bank"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:visibility="gone"
            tools:visibility="gone">

            <FrameLayout
                android:layout_width="32dp"
                android:layout_height="32dp">

                <ImageView
                    android:id="@+id/ivSelectedBankLogo"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_gravity="center"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_bank"
                    app:tint="@color/brand_blue" />
            </FrameLayout>

            <TextView
                android:id="@+id/tvSelectedBankName"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:text="HDFC Bank"
                android:textColor="@color/md3_on_surface"
                android:textSize="14sp"
                android:textStyle="bold"
                tools:text="HDFC Bank" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Change"
                android:textColor="@color/brand_blue"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Bank grid — 3-column, scrollable if needed -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvBankGrid"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:nestedScrollingEnabled="false"
            tools:itemCount="9"
            tools:listitem="@layout/item_bank_picker" />


        <!-- ── SECTION 2: Account holder name ── -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:letterSpacing="0.02"
            android:text="Applicant Details"
            android:textColor="@color/md3_on_surface"
            android:textSize="13sp"
            android:textStyle="bold" />

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilAccountName"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:hint="Full Name"
            app:boxBackgroundColor="#FAFAFA"
            app:boxCornerRadiusBottomEnd="14dp"
            app:boxCornerRadiusBottomStart="14dp"
            app:boxCornerRadiusTopEnd="14dp"
            app:boxCornerRadiusTopStart="14dp"
            app:boxStrokeColor="@color/brand_blue"
            app:boxStrokeWidth="1.5dp"
            app:startIconTint="@color/black">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etAccountName"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:imeOptions="actionDone"
                android:inputType="textPersonName|textCapWords"
                android:textColor="@color/md3_on_surface"
                android:textSize="15sp" />


        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/etPIN"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:hint="Enter Transaction PIN"
            app:boxBackgroundColor="#FAFAFA"
            app:boxCornerRadiusBottomEnd="14dp"
            app:boxCornerRadiusBottomStart="14dp"
            app:boxCornerRadiusTopEnd="14dp"
            app:boxCornerRadiusTopStart="14dp"
            app:boxStrokeColor="@color/brand_blue"
            app:boxStrokeWidth="1.5dp"
            app:startIconTint="@color/black">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etPin"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:imeOptions="actionDone"
                android:inputType="textPersonName|textCapWords"
                android:textColor="@color/md3_on_surface"
                android:textSize="15sp" />


        </com.google.android.material.textfield.TextInputLayout>


        <!-- ── Link Account button — disabled until both fields filled ── -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnLinkAccount"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="20dp"
            android:enabled="false"
            android:text="@string/btn_link_account"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold"
            app:backgroundTint="@color/brand_blue"
            app:cornerRadius="16dp"
            app:elevation="0dp"
            app:icon="@drawable/ic_bank"
            app:iconGravity="textStart"
            app:iconPadding="8dp"
            app:iconTint="#FFFFFF"
            app:rippleColor="#33FFFFFF" />

    </LinearLayout>

    <LinearLayout
        android:id="@+id/stateConfirm"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingTop="24dp"
        android:paddingEnd="24dp"
        android:paddingBottom="36dp"
        android:visibility="gone"
        tools:visibility="gone">

        <FrameLayout
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:background="@drawable/bg_step_icon_pending">

            <ImageView
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_gravity="center"
                android:contentDescription="Success"
                app:tint="#FFFFFF" />
        </FrameLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="@string/bank_linked_title"
            android:textColor="@color/md3_on_surface"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:gravity="center"
            android:text="@string/bank_linked_subtitle"
            android:textColor="@color/md3_on_surface_variant"
            android:textSize="13sp" />

        <!-- Confirmation detail card -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            app:cardBackgroundColor="#FAFAFA"
            app:cardCornerRadius="16dp"
            app:cardElevation="0dp"
            app:strokeColor="@color/md3_outline_variant"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <!-- Bank name row -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <FrameLayout
                        android:layout_width="36dp"
                        android:layout_height="36dp">

                        <ImageView
                            android:id="@+id/ivConfirmBankLogo"
                            android:layout_width="22dp"
                            android:layout_height="22dp"
                            android:layout_gravity="center"
                            android:contentDescription="@null"
                            android:src="@drawable/ic_bank"
                            app:tint="@color/brand_blue" />
                    </FrameLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tvConfirmBankName"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="HDFC Bank"
                            android:textColor="@color/md3_on_surface"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            tools:text="HDFC Bank" />

                        <TextView
                            android:id="@+id/tvConfirmAccountHolder"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="Laxman Kadam"
                            android:textColor="@color/md3_on_surface_variant"
                            android:textSize="12sp"
                            tools:text="Laxman Kadam" />
                    </LinearLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:paddingStart="8dp"
                        android:paddingTop="3dp"
                        android:paddingEnd="8dp"
                        android:paddingBottom="3dp"
                        android:text="Linked"
                        android:textColor="#065F46"
                        android:textSize="10sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="12dp"
                    android:layout_marginBottom="12dp"
                    android:background="@color/md3_outline_variant" />

                <!-- Masked account number -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/confirm_account_label"
                        android:textColor="@color/md3_on_surface_variant"
                        android:textSize="12sp" />

                    <TextView
                        android:id="@+id/tvConfirmAccountMasked"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="••••  ••••  4821"
                        android:textColor="@color/md3_on_surface"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        tools:text="••••  ••••  4821" />
                </LinearLayout>

                <!-- IFSC -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/confirm_ifsc_label"
                        android:textColor="@color/md3_on_surface_variant"
                        android:textSize="12sp" />

                    <TextView
                        android:id="@+id/tvConfirmIfsc"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="HDFC0001234"
                        android:textColor="@color/md3_on_surface"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        tools:text="HDFC0001234" />
                </LinearLayout>

                <!-- Starting balance (server-assigned, read-only) -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/confirm_balance_label"
                        android:textColor="@color/md3_on_surface_variant"
                        android:textSize="12sp" />

                    <TextView
                        android:id="@+id/tvConfirmBalance"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="₹12,000.00"
                        android:textColor="@color/status_success"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        tools:text="₹12,000.00" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Auto-dismiss progress strip -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ProgressBar
                android:id="@+id/progressAutoDismiss"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="0dp"
                android:layout_height="4dp"
                android:layout_weight="1"
                android:indeterminate="false"
                android:max="100"
                android:progress="0"
                android:progressBackgroundTint="@color/md3_outline_variant"
                android:progressTint="@color/brand_blue" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:text="@string/auto_dismiss_hint"
                android:textColor="@color/md3_on_surface_variant"
                android:textSize="11sp" />
        </LinearLayout>

    </LinearLayout>

</LinearLayout>
