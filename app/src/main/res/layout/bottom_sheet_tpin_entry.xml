<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_bottom_sheet"
    android:orientation="vertical">

    <!-- Drag handle -->
    <View
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="10dp"
        android:background="@drawable/bg_drag_handle" />

    <!-- ══ STATE A: TPIN entry ══ -->
    <LinearLayout
        android:id="@+id/stateTpin"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="16dp"
        android:paddingBottom="28dp"
        android:visibility="visible">

        <!-- Bank identity row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <FrameLayout
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="@drawable/bg_bank_item_default">

                <ImageView
                    android:id="@+id/ivTpinBankLogo"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_bank"
                    android:contentDescription="Bank logo"
                    app:tint="@color/brand_blue" />

            </FrameLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="12dp"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvTpinBankName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="#111827"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Enter your 6 digit TPIN to verify"
                    android:textColor="@color/md3_on_surface_variant"
                    android:textSize="12sp" />

            </LinearLayout>

        </LinearLayout>

        <!-- Divider -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="12dp"
            android:background="@color/md3_outline_variant" />

        <!-- TPIN label -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:text="TPIN"
            android:textColor="@color/md3_on_surface"
            android:textSize="13sp"
            android:textStyle="bold" />

        <!-- TPIN input -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilTpin"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"

            >

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etTpin"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:imeOptions="actionDone"
                android:inputType="numberPassword"
                android:maxLength="6"
                android:textSize="18sp" />

        </com.google.android.material.textfield.TextInputLayout>

        <!-- Helper text row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:contentDescription="Security icon"
                app:tint="#16A34A" />



        </LinearLayout>

        <!-- Verify button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnVerifyTpin"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="20dp"
            android:enabled="false"
            android:text="Verify &amp; Check Balance"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold"
            app:backgroundTint="@color/brand_blue"
            app:cornerRadius="16dp"
            app:iconGravity="textStart"
            app:iconTint="#FFFFFF" />

    </LinearLayout>

    <!-- ══ STATE B: Verifying ══ -->
    <LinearLayout
        android:id="@+id/stateVerifying"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:paddingTop="32dp"
        android:paddingBottom="32dp"
        android:visibility="gone">

        <ProgressBar
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:id="@+id/progressBar"
            android:indeterminate="true"
            android:indeterminateTint="@color/brand_blue" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Verifying your TPIN…"
            android:textColor="@color/md3_on_surface"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Securely fetching your balance"
            android:textColor="@color/md3_on_surface_variant"
            android:textSize="13sp" />

    </LinearLayout>

</LinearLayout>
